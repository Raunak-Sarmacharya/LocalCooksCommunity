{
  "functions": [{
    "source": "functions",
    "codebase": "staging",
    "runtime": "nodejs22",
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", ".env*", ".secret*"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  }],
  "firestore": {
    "database": "staging",
    "rules": "firestore.rules",
    "indexes": "firestore.staging.indexes.json"
  }
}
