rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User documents are non-authoritative profile metadata. Application roles
    // live in Neon and are enforced by the API, never by client-writable fields.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'createdAt', 'lastLoginAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'lastLoginAt', 'updatedAt'
        ]);
      allow delete: if false;
    }
    
    // ============================================
    // CHAT CONVERSATIONS - Real-time messaging
    // HIGH-3 Security: Restrict to conversation participants only
    // ============================================
    match /conversations/{conversationId} {
      // Helper: check if current user is a participant in this conversation
      function isParticipant() {
        return request.auth.uid == resource.data.chefFirebaseUid 
            || request.auth.uid == resource.data.managerFirebaseUid;
      }
      
      // Only participants can read their own conversations
      allow read: if isAuthenticated() && isParticipant();
      // Conversation creation still uses legacy numeric participant IDs.
      // Migrating it to server-issued Firebase UIDs is tracked separately;
      // changing this rule alone would break chat creation.
      allow create: if isAuthenticated();
      // Only participants can update
      allow update: if isAuthenticated() && isParticipant();
      // No deletes
      allow delete: if false;
      
      // Messages subcollection - restricted to conversation participants
      match /messages/{messageId} {
        // Check parent conversation to verify participant access
        function isConversationParticipant() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId));
          return request.auth.uid == conv.data.chefFirebaseUid 
              || request.auth.uid == conv.data.managerFirebaseUid;
        }
        
        allow read: if isAuthenticated() && isConversationParticipant();
        allow create: if isAuthenticated() && isConversationParticipant();
        allow update: if isAuthenticated() && isConversationParticipant();
        allow delete: if false;
      }
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
