  "mainPath": ["select_kitchen", "edit_schedule", "save_api", "kitchen_tables", "discover_slots", "book_tour", "kitchen_conflict"],
  "nodes": [
    { "id": "select_kitchen", "lane": "manager", "col": 0, "type": "frontend", "label": "Select Kitchen", "sublabel": "availability dropdown" },
