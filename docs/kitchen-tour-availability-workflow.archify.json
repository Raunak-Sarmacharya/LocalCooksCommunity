    { "id": "save_api", "lane": "api", "col": 2, "type": "backend", "label": "Save by kitchenId", "sublabel": "settings / hours / blackouts", "width": 124 },
    { "id": "kitchen_tables", "lane": "storage", "col": 3, "type": "database", "label": "Kitchen Tour Tables", "sublabel": "kitchen_id is scope", "width": 138 },
    { "id": "discover_slots", "lane": "chef", "col": 4, "type": "frontend", "label": "Discover Slots", "sublabel": "selected kitchen only" },
    { "id": "book_tour", "lane": "api", "col": 5, "type": "backend", "label": "Book Tour", "sublabel": "validate kitchen + location", "width": 116 },
    { "id": "kitchen_conflict", "lane": "storage", "col": 5, "type": "security", "label": "Conflict Check", "sublabel": "same kitchen only" },
