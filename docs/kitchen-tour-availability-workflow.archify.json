  "cards": [
    { "dot": "emerald", "title": "Save Contract", "items": ["Defaults form the baseline even before a row exists", "Any edit enables its matching Save button", "A successful save resets only that baseline"] },
    { "dot": "cyan", "title": "Kitchen Scope", "items": ["Settings, hours, blackouts, slots, and conflicts share kitchenId", "locationId remains for ownership and reporting"] }
