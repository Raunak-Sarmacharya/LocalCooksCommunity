{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Daily-rate Financial Flow",
    "quality_profile": "showcase",
    "output": "docs/daily-rate-financial-flow.html",
    "viewBox": [1080, 600]
  },
  "stages": [
    { "label": "Booking" },
    { "label": "Capture" },
    { "label": "Resolution" },
    { "label": "Documents" }
  ],
  "nodes": [
    { "id": "selection", "type": "frontend", "label": "Rate selection", "sublabel": "daily or hourly", "stage": 0, "row": 0 },
    { "id": "metadata", "type": "database", "label": "Checkout metadata", "sublabel": "pricing mode + applied rate", "stage": 1, "row": 0, "width": 150 },
    { "id": "booking", "type": "database", "label": "Booking totals", "sublabel": "captured subtotal + duration", "stage": 1, "row": 2, "width": 150 },
    { "id": "resolver", "type": "backend", "label": "Rate resolver", "sublabel": "daily quantity is always one", "stage": 2, "row": 1, "width": 150 },
    { "id": "invoice", "type": "backend", "label": "Invoice", "sublabel": "flat daily line item", "stage": 3, "row": 0, "width": 120 },
    { "id": "payout", "type": "backend", "label": "Payout statement", "sublabel": "reconciled subtotal and net", "stage": 3, "row": 2, "width": 150 }
  ],
  "flows": [
    { "from": "selection", "to": "metadata", "label": "pricingMode", "classification": "captured fact", "variant": "emphasis", "route": "straight", "labelDy": -30 },
    { "from": "selection", "to": "booking", "label": "subtotal and hours", "classification": "money snapshot", "variant": "default" },
    { "from": "metadata", "to": "resolver", "label": "explicit mode", "classification": "authoritative", "variant": "emphasis" },
    { "from": "booking", "to": "resolver", "label": "legacy fallback", "classification": "inferred when absent", "variant": "dashed" },
    { "from": "resolver", "to": "invoice", "label": "daily rate × 1", "classification": "display amount", "variant": "emphasis" },
    { "from": "resolver", "to": "payout", "label": "reconciled money", "classification": "subtotal + tax − fees", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "rose", "title": "Invariant", "items": ["A daily rate is never multiplied by booked hours"] },
    { "dot": "emerald", "title": "Compatibility", "items": ["Older rows infer mode from captured subtotal; new rows carry pricing mode"] }
  ]
}
