    { "id": "phone-email", "from": "details", "to": "verifyemail", "label": "phone-first", "variant": "security", "role": "branch" },
    { "id": "details-validate", "from": "details", "to": "validate", "label": "email / Google", "variant": "default" },
    { "id": "verified-validate", "from": "verifyemail", "to": "validate", "variant": "security" },
    { "id": "validate-create", "from": "validate", "to": "create", "variant": "emphasis" },
    { "id": "create-dashboard", "from": "create", "to": "dashboard", "variant": "emphasis" },
    { "id": "existing-dashboard", "from": "existing", "to": "dashboard", "label": "existing UID", "variant": "emphasis", "role": "branch", "route": "up-channel" },
    { "id": "dashboard-checklist", "from": "dashboard", "to": "checklist", "label": "details missing", "variant": "dashed", "role": "branch" }
  ]
