{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Corrected Application, Tour, Booking, and Refund States",
    "output": "docs/platform-status-fixes.html",
    "viewBox": [1080, 720],
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "main", "label": "Applicant journey" },
    { "id": "tour", "label": "Kitchen tour" },
    { "id": "terminal", "label": "Payment outcomes" }
  ],
  "states": [
    { "id": "rejected", "type": "start", "label": "Rejected", "sublabel": "documents need changes", "lane": "main", "col": 0 },
    { "id": "contactReady", "type": "active", "label": "Contact Ready", "sublabel": "phone can be edited", "lane": "main", "col": 1 },
    { "id": "resubmitted", "type": "waiting", "label": "Resubmitted", "sublabel": "admin review", "lane": "main", "col": 2 },
    { "id": "accessGranted", "type": "success", "label": "Access Granted", "sublabel": "open kitchen preview", "lane": "main", "col": 3 },
    { "id": "bookingReady", "type": "success", "label": "Booking Ready", "sublabel": "full-day checkout", "lane": "main", "col": 4 },
    { "id": "tourPending", "type": "waiting", "label": "Tour Pending", "sublabel": "contact and kitchen visible", "lane": "tour", "col": 0 },
    { "id": "tourAccepted", "type": "active", "label": "Tour Accepted", "sublabel": "manager can contact chef", "lane": "tour", "col": 1 },
    { "id": "checkoutFailure", "type": "failure", "label": "Checkout Failed", "sublabel": "recoverable metadata error", "lane": "terminal", "col": 2 },
    { "id": "invoiceCorrect", "type": "success", "label": "Invoice Correct", "sublabel": "net paid after refund", "lane": "terminal", "col": 0 }
  ],
  "transitions": [
    { "id": "retryCheckout", "from": "checkoutFailure", "to": "bookingReady", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Contact and navigation",
      "items": [
        "Applicants can correct a missing phone before resubmission",
        "Tour reviewers see chef contact details and the requested kitchen",
        "Kitchen access opens the selected kitchen preview"
      ]
    },
    {
      "dot": "amber",
      "title": "Money and status",
      "items": [
        "Full-day checkout sends compact metadata",
        "Refund actions live in one booking workflow",
        "Refunded invoices show the amount retained after refund"
      ]
    }
  ]
}
