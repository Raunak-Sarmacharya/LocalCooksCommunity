    { "id": "edit_email", "lane": "profile_ui", "col": 2, "type": "frontend", "label": "Notification Email", "sublabel": "email only", "width": 146 },
    { "id": "submit_email", "lane": "profile_ui", "col": 3, "type": "frontend", "label": "Save Settings", "sublabel": "locationId + email", "width": 142 },
    { "id": "update_location", "lane": "location_api", "col": 4, "type": "backend", "label": "Update Location", "sublabel": "authenticated PUT", "width": 142 },
