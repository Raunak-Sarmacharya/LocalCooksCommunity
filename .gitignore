# Local Cooks Community - .gitignore

# ===================================
# Node.js Dependencies
# ===================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ===================================
# Environment Variables & Secrets
# ===================================
.env
.env.*
!.env.example
!.env.*.example
!.env.production.example
!.env.development.example

# Specific environment files
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local

# Firebase configuration (extra protection)
**/firebase-config*.json
**/.firebaserc
**/firebase.json

# OAuth and API Keys (extra protection)
**/client_secret*.json
**/credentials*.json
**/*_key.json
**/*_secret.json
**/oauth_*.json
**/service-account*.json
**/*-key.json
**/*-secret.json

# API keys and tokens
*.token
*.secret
api-keys.json
secrets.json

# Vercel environment files
.vercel/
.vercel/.env*
.vercel/project.json

# Railway deployment
.railway/

# Build Artifacts & Backups (Clean Repo)
api/


# ===================================
# Build Outputs & Distribution
# ===================================
dist/
build/
.next/
.nuxt/
out/
server/public/
client/dist/
client/build/

# Vite build artifacts
vite.config.ts.*
vite.config.*.timestamp-*

# TypeScript build cache
*.tsbuildinfo
.tsc-cache/

# Turbo
.turbo/

# ===================================
# File Uploads & User Content
# ===================================
uploads/
user-uploads/
public/uploads/
temp-uploads/
documents/
files/

# Local file storage (development)
local-storage/
blob-storage/

# ===================================
# Database Files
# ===================================
*.db
*.sqlite
*.sqlite3
database.json
migrations/local/
*.dump
*.sql.backup

# ===================================
# Development Tools & IDEs
# ===================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Vim/Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ===================================
# Operating System Files
# ===================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ===================================
# Logs & Runtime Data
# ===================================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# Coverage reports
coverage/
*.lcov
.nyc_output/
.coverage/

# ===================================
# Package Manager Files
# ===================================
# npm
.npm/
node_modules.bak/
npm-shrinkwrap.json

# Yarn
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity
.pnp.*

# pnpm
.pnpm-debug.log*
.pnpm-store/

# ===================================
# Testing & Quality Assurance
# ===================================
# Jest
.jest/
test-results/
junit.xml

# Playwright
playwright-report/
test-results/
playwright/.cache/

# ESLint
.eslintcache

# ===================================
# Deployment & Hosting
# ===================================
# Vercel
.vercel/
.vercel.json

# Netlify
.netlify/

# Railway
.railway/

# Docker
Dockerfile.local
docker-compose.override.yml
.dockerignore.local

# ===================================
# SSL Certificates & Security
# ===================================
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
ssl/

# ===================================
# Cache & Temporary Files
# ===================================
.cache/
.parcel-cache/
.next/cache/
.tmp/
tmp/
temp/

# Optional REPL history
.node_repl_history

# ===================================
# Local Development Files
# ===================================
.local/
local.json
dev.db
development.db

# Session store (if using file-based sessions)
sessions/

# ===================================
# Backup & Archive Files
# ===================================
*.backup
*.bak
*.orig
*.tar.gz
*.zip
*.rar

# ===================================
# Documentation Generation
# ===================================
docs-temp/
api-docs/generated/

# ===================================
# Monitoring & Analytics
# ===================================
.sentryclirc

# ===================================
# Local Cooks Specific
# ===================================
# Application documents (uploaded files)
documents/
certificates/
licenses/
food-safety-licenses/
establishment-certificates/

# Local admin uploads
admin-uploads/

# Test files
test-certificate.pdf
test-files/
sample-documents/
test-uploads/

# Local configuration overrides
config/local.*
config/development.*
config/production.*

# Email templates cache
email-cache/

# Session files (if using file store)
session-store/
sessions/

# Local database files
*.db-journal
*.sqlite-journal
local-cooks.db
localcooks.db

# Auth provider configs (if downloaded)
google-oauth-*.json
facebook-app-*.json

# Local development overrides
.env.local.override
local-settings.json

# ===================================
# Keep These Files (Negative Patterns)
# ===================================
!.env.example
!.gitkeep
!docs/
!README.md

